{
  "name": "videorip-mobile",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test:logic": "node --test tests/*.test.mjs",
    "verify:static": "python3 scripts/verify_project.py",
    "verify": "npm run test:logic && npm run verify:static && npx expo-doctor",
    "build:android:preview": "npx eas-cli@latest build -p android --profile preview",
    "build:android:production": "npx eas-cli@latest build -p android --profile production",
    "build:ios:production": "npx eas-cli@latest build -p ios --profile production",
    "build:android:apk": "npx eas-cli@latest build -p android --profile standalone-apk"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.18.16",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.6",
    "expo": "57.0.9",
    "expo-battery": "57.0.1",
    "expo-clipboard": "57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-image-picker": "57.0.7",
    "expo-keep-awake": "57.0.1",
    "expo-media-library": "57.0.3",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.8",
    "expo-screen-orientation": "57.0.1",
    "expo-sharing": "57.0.8",
    "expo-system-ui": "57.0.1",
    "expo-video": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
